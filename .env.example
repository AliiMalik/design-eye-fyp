# Root-level env consumed by docker-compose.yml.
# Copy to .env and set a real secret:  openssl rand -base64 48
JWT_SECRET=replace-with-a-random-48-byte-secret

LLM_TIMEOUT_SECONDS=90
LLM_PROVIDER=mock
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Storage: 'local' (default) or 'cloudinary'
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- deployment ---
# For cloud hosting set these to your real origins. NEXT_PUBLIC_API_URL is
# compiled into the frontend bundle, so changing it requires:
#   docker compose build frontend
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
# false routes inference through the Celery worker instead of inline
DEV_MODE=true

# --- password reset ---
# No mail service in this build: the reset token comes back in the API response
# instead. Never enable this where other people can reach the API.
EXPOSE_RESET_TOKEN=false
